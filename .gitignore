node_modules/
dist/
coverage/
target/
.DS_Store
playwright-report/
test-results/
work/references/

# The machine-wide ignore file excludes directories named Desktop. Keep this
# workspace's lowercase desktop package versioned explicitly.
!apps/
!apps/desktop/
!apps/desktop/**
# The desktop include above must not re-include Finder metadata.
apps/desktop/**/.DS_Store
apps/desktop/node_modules/
apps/desktop/dist/
apps/desktop/src-tauri/target/

# The machine-wide ignore file also excludes directories named Public on
# case-insensitive macOS filesystems. The website's static assets are release
# inputs and must be versioned.
!apps/site/
!apps/site/public/
!apps/site/public/**

# Android node local build products and machine-specific SDK path.
apps/android-node/.gradle/
apps/android-node/local.properties
apps/android-node/**/build/
apps/android-node/**/.cxx/
